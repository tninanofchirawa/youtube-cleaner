{
  "manifest_version": 3,
  "name": "YouTube Cleaner - Minimal AI Interface",
  "version": "1.0",
  "description": "Minimal AI-Style YouTube Interface",
  "content_scripts": [{
    "matches": ["*://*.youtube.com/*"],
    "css": [
      "styles/common.css",
      "styles/home.css",
      "styles/channel.css",
      "styles/playlist.css",
      "styles/video.css",
      "styles/search.css"
    ],
    "js": [
      "scripts/common.js",
      "scripts/home.js",
      "scripts/channel.js",
      "scripts/playlist.js",
      "scripts/video.js",
      "scripts/search.js",
      "scripts/main.js"
    ],
    "run_at": "document_start"
  }]
}