{
  "manifest_version": 3,
  "name": "YouTube Cleaner - Minimal AI Interface",
  "version": "1.0",
  "description": "Minimal AI-Style YouTube Interface",
  "content_scripts": [{
    "matches": ["*://*.youtube.com/*"],
    "css": ["clean.css"],
    "js": ["script.js"],
    "run_at": "document_start"
  }]
}